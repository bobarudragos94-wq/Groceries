# Turso (producție). Dacă lipsesc, se folosește SQLite local: file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Parola pentru panoul de admin (/admin).
# OBLIGATORIE în producție (și diferită de „admin”) — altfel panoul răspunde 503.
ADMIN_PASSWORD=schimba-ma

# Secretul pentru semnarea cookie-urilor de sesiune (uid).
# OBLIGATORIU în producție; generează cu: openssl rand -hex 32
AUTH_SECRET=

# Vechimea maximă (zile) a unui preț ca să mai fie afișat (implicit 14).
# Ofertele cu valid_to depășit dispar oricum imediat.
PRICE_MAX_AGE_DAYS=

# Scraper (opțional)
# Implicit Kaufland acoperă TOATE JUDEȚELE (un magazin reprezentativ/județ).
# KAUFLAND_SCOPE=all       -> toate cele ~204 magazine (mai lent, mai granular)
# KAUFLAND_CITIES=a,b,c    -> doar orașele date (suprascrie selecția pe județe)
KAUFLAND_SCOPE=
KAUFLAND_CITIES=
# Cuvinte de căutare suplimentare pentru Lidl (plasa de siguranță pe lângă
# parcurgerea completă a categoriilor; separate prin virgulă)
LIDL_EXTRA_QUERIES=
# Calea către Chromium pentru scraperul Profi (Cloudflare cere browser real)
PROFI_CHROMIUM_PATH=
# Categoriile Carrefour de parcurs (slug-uri de URL, separate prin virgulă).
# Implicit: bacanie-carrefour,cosmetice-si-ingrijire-personala
CARREFOUR_CATEGORIES=

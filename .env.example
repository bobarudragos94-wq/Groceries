# Turso (producție). Dacă lipsesc, se folosește SQLite local: file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Parola pentru panoul de admin (/admin)
ADMIN_PASSWORD=schimba-ma

# Scraper (opțional)
# Orașe pentru prețurile Kaufland (magazinul principal din fiecare oraș)
KAUFLAND_CITIES=București,Cluj-Napoca,Timișoara,Iași,Constanța
# Cuvinte de căutare suplimentare pentru Lidl (separate prin virgulă)
LIDL_EXTRA_QUERIES=
# Calea către Chromium pentru scraperul Profi (Cloudflare cere browser real)
PROFI_CHROMIUM_PATH=

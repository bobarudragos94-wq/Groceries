{
  "name": "cosul-ieftin-harvester",
  "version": "1.0.0",
  "private": true,
  "description": "Culege prețuri de pe site-urile protejate (Profi, Metro, La Cocoș) folosind browserul tău și le salvează ca CSV pentru importul în Coșul Ieftin",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "bundle": "esbuild src/index.js --bundle --platform=node --target=node20 --outfile=build/harvester.cjs",
    "build": "node build.js",
    "build:all": "node build.js --linux"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
